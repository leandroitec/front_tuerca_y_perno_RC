# URL base del Backend Django REST Framework (SimpleJWT)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/

# true: utiliza datos simulados | false: utiliza el backend Django
NEXT_PUBLIC_USE_PRODUCT_MOCKS=false

# Ventas: true (o sin definir) usa datos simulados | false usa el backend Django
NEXT_PUBLIC_USE_VENTA_MOCKS=true
